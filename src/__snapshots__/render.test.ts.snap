// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toHtml > renders every block type as a plain fragment 1`] = `
"<article class="dfs-report">
<hgroup id="title"><p class="dfs-kicker">Sample · October 8, 2026</p><h1>Example report</h1></hgroup>
<p id="answer" class="dfs-lg">The <strong>answer</strong>, with <code>code</code> and a <a href="https://example.com" rel="noopener">link</a>.</p>
<dl class="dfs-terms"><div><dt>answer</dt><dd>The one line at the top.</dd></div></dl>
<dl class="dfs-stats" id="stats">
<div class="dfs-stat dfs-good"><dt>Visits</dt><dd class="dfs-value"><a href="#rows">1,241</a></dd><dd class="dfs-note">a month</dd></div>
<div class="dfs-stat"><dt>Share</dt><dd class="dfs-value">7%</dd></div>
</dl>
<h2 id="rows-title">Rows</h2>
<div class="dfs-table" id="rows" tabindex="0"><table>
<thead><tr><th scope="col">Term</th><th scope="col">Position</th><th scope="col" class="dfs-num">Visits</th><th scope="col" class="dfs-num">Share</th><th scope="col">Page</th></tr></thead>
<tbody>
<tr><td>plumber</td><td><span class="dfs-badge dfs-good">#2</span></td><td class="dfs-num">2,400</td><td class="dfs-num"><span class="dfs-bar" aria-hidden="true" style="--w:100"></span>50</td><td><code>/</code></td></tr>
<tr><td>drain</td><td><span class="dfs-badge">#14</span></td><td class="dfs-num"></td><td class="dfs-num"><span class="dfs-bar" aria-hidden="true" style="--w:50"></span>25</td><td><code>/drains</code></td></tr>
</tbody>
</table></div>
<dl class="dfs-terms"><div><dt>Position</dt><dd>Where it ranks.</dd></div></dl>
<aside class="dfs-callout dfs-warn" id="warn"><p><strong>Check this.</strong> One page redirects home.</p></aside>
<aside class="dfs-callout dfs-info" id="info"><p><strong>Note.</strong> No title, so the tone names it.</p></aside>
<ol id="steps">
<li>First</li>
<li>Second</li>
</ol>
<details id="more" open>
<summary>How this was measured</summary>
<ul>
<li><strong>What:</strong> everything</li>
</ul>
</details>
<figure class="dfs-chart" id="trend"><figcaption>Visits by month</figcaption><div class="dfs-table" tabindex="0"><table>
<thead><tr><td></td><th scope="col" class="dfs-num">Visits</th></tr></thead>
<tbody>
<tr><th scope="row">Sep</th><td class="dfs-num">1,100</td></tr>
<tr><th scope="row">Oct</th><td class="dfs-num">1,241</td></tr>
</tbody>
</table></div></figure>
<footer class="dfs-footer" id="footer"><p>Data: example, October 8, 2026.</p></footer>
</article>
"
`;

exports[`toHtml > renders the ai-visibility report 1`] = `
"<article class="dfs-report">
<hgroup id="title"><p class="dfs-kicker">AI visibility · October 8, 2026</p><h1>Acme Plumbing in AI answers</h1></hgroup>
<p id="answer" class="dfs-lg">AI answers in DataForSEO’s sample link acmeplumbing.example as a source 3 times and name Acme Plumbing once.</p>
<dl class="dfs-stats" id="stats">
<div class="dfs-stat"><dt>Citations</dt><dd class="dfs-value"><a href="#platforms-title">3</a></dd><dd class="dfs-note">answers linking acmeplumbing.example</dd></div>
<div class="dfs-stat"><dt>Mentions</dt><dd class="dfs-value"><a href="#platforms-title">1</a></dd><dd class="dfs-note">answers naming Acme Plumbing</dd></div>
<div class="dfs-stat"><dt>Topics checked</dt><dd class="dfs-value"><a href="#topics-title">2</a></dd><dd class="dfs-note">acmeplumbing.example a top source in 1</dd></div>
<div class="dfs-stat"><dt>Pages cited</dt><dd class="dfs-value"><a href="#pages-title">1</a></dd><dd class="dfs-note">in 1 top question</dd></div>
</dl>
<details id="method">
<summary>How this was measured</summary>
<ul id="method-list">
<li><strong>What:</strong> How often AI answers name Acme Plumbing (a mention) and link a page on acmeplumbing.example as a source (a citation).</li>
<li><strong>Where:</strong> ChatGPT and Google AI Overviews, United States, English.</li>
<li><strong>When:</strong> Data pulled October 8, 2026.</li>
<li><strong>Source:</strong> DataForSEO LLM Mentions, a large sample of AI answers to real questions. Counts are answers in that sample, not every conversation, and the same question can get a different answer each time.</li>
<li><strong>Name matching:</strong> An answer counts as a mention when it contains “Acme Plumbing”. A name made of common words also matches generic phrases, so the mention count can run high.</li>
<li><strong>Topics:</strong> For questions containing “water heater repair” and “sewer line repair”, the sites the answers cite most.</li>
<li><strong>Questions:</strong> The question with the most AI searches a month whose answers cite acmeplumbing.example.</li>
</ul>
</details>
<h2 id="actions-title">What to do</h2>
<p id="actions-intro">AI tools tend to link pages that answer one question plainly.</p>
<ul id="actions">
<li>For questions about “water heater repair”, AI answers cite rivalplumbing.example, forum.example and hardware.example most. acmeplumbing.example isn’t in the top 3.</li>
</ul>
<h2 id="platforms-title">By platform</h2>
<p id="platforms-note">A mention is the name in the answer’s text. A citation is a link to the site among its sources. Either can happen without the other.</p>
<dl class="dfs-terms"><div><dt>mention</dt><dd>The AI answer names the organization in its text, with or without a link.</dd></div><div><dt>citation</dt><dd>The AI answer links a page on the site as one of its sources.</dd></div></dl>
<div class="dfs-table" id="platforms" tabindex="0"><table>
<thead><tr><th scope="col">Platform</th><th scope="col" class="dfs-num">Mentions</th><th scope="col" class="dfs-num">Citations</th></tr></thead>
<tbody>
<tr><td>ChatGPT</td><td class="dfs-num">1</td><td class="dfs-num">0</td></tr>
<tr><td>Google AI Overviews</td><td class="dfs-num">0</td><td class="dfs-num">3</td></tr>
</tbody>
</table></div>
<h2 id="topics-title">Topics checked</h2>
<p id="topics-note">The sites AI answers cite most often for questions containing each topic. “No” means acmeplumbing.example isn’t among those top sites, not that it’s never cited. “Too few answers” means under 10 answers in the sample.</p>
<div class="dfs-table" id="topics" tabindex="0"><table>
<thead><tr><th scope="col">Topic</th><th scope="col">acmeplumbing.example a top source</th><th scope="col" class="dfs-num">Answers found</th><th scope="col">Most cited sites</th></tr></thead>
<tbody>
<tr><td>water heater repair</td><td><span class="dfs-badge dfs-warn">No</span></td><td class="dfs-num">90</td><td>rivalplumbing.example, forum.example, hardware.example</td></tr>
<tr><td>sewer line repair</td><td><span class="dfs-badge dfs-good">Yes</span></td><td class="dfs-num">40</td><td>acmeplumbing.example</td></tr>
</tbody>
</table></div>
<dl class="dfs-terms"><div><dt>Answers found</dt><dd>Answers in the sample to questions that contain the topic.</dd></div></dl>
<h2 id="pages-title">Pages AI cites</h2>
<p id="pages-note">From the question with the most AI searches a month whose answers link acmeplumbing.example.</p>
<div class="dfs-table" id="pages" tabindex="0"><table>
<thead><tr><th scope="col">Page</th><th scope="col" class="dfs-num">Questions</th><th scope="col" class="dfs-num">AI searches a month</th></tr></thead>
<tbody>
<tr><td><code>/sewer</code></td><td class="dfs-num">1</td><td class="dfs-num">260</td></tr>
</tbody>
</table></div>
<dl class="dfs-terms"><div><dt>AI searches a month</dt><dd>DataForSEO’s estimate of how often people ask AI tools that question in a month.</dd></div></dl>
<h2 id="prompts-title">Answers that cite the site</h2>
<div class="dfs-table" id="prompts" tabindex="0"><table>
<thead><tr><th scope="col">Question</th><th scope="col">Where</th><th scope="col" class="dfs-num">AI searches a month</th><th scope="col">Page cited</th></tr></thead>
<tbody>
<tr><td>who fixes sewer lines in springfield</td><td>Google AI Overviews</td><td class="dfs-num">260</td><td><code>/sewer</code></td></tr>
</tbody>
</table></div>
<footer class="dfs-footer" id="footer"><p>Data: DataForSEO LLM Mentions, October 8, 2026.</p></footer>
</article>
"
`;

exports[`toHtml > renders the backlink-redirects report 1`] = `
"<article class="dfs-report">
<hgroup id="title"><p class="dfs-kicker">Broken link check · October 8, 2026</p><h1>acmeplumbing.example links that fail today</h1></hgroup>
<p id="answer" class="dfs-lg">3 addresses that other sites link to fail on the live site, https://staging.acmeplumbing.example. Counted per address, they have 62 linking sites.</p>
<dl class="dfs-terms"><div><dt>linking site</dt><dd>Other websites with at least one link to that address. Each site counts once.</dd></div></dl>
<dl class="dfs-stats" id="stats">
<div class="dfs-stat dfs-bad"><dt>Broken</dt><dd class="dfs-value"><a href="#fix">3</a></dd><dd class="dfs-note">62 linking sites</dd></div>
<div class="dfs-stat"><dt>Redirecting</dt><dd class="dfs-value"><a href="#redirecting-title">3</a></dd><dd class="dfs-note">land on a live page</dd></div>
<div class="dfs-stat"><dt>Unchanged</dt><dd class="dfs-value"><a href="#unchanged-title">1</a></dd><dd class="dfs-note">same address, still live</dd></div>
<div class="dfs-stat dfs-warn"><dt>Behind a login</dt><dd class="dfs-value"><a href="#gated-title">1</a></dd><dd class="dfs-note">couldn’t be checked</dd></div>
</dl>
<details id="method">
<summary>How this was measured</summary>
<ul id="method-list">
<li><strong>What:</strong> The 100 old acmeplumbing.example addresses with the most linking sites, of 170 that have any. Variants that differ only by http, www, subdomain or tracking tags count as one, which leaves 8 addresses.</li>
<li><strong>How:</strong> Each address is requested on https://staging.acmeplumbing.example and followed through any redirects to where it ends up.</li>
<li><strong>Results:</strong> Broken: ends on a missing page or an error. Redirecting: forwards to a live page. Unchanged: same address, still live. Behind a login: hit a sign-in page, so it couldn’t be checked.</li>
<li><strong>When:</strong> Links counted October 8, 2026; addresses checked October 8, 2026.</li>
<li><strong>Source:</strong> DataForSEO Backlinks for the linked addresses and their linking sites. The checks run directly against the site.</li>
</ul>
</details>
<h2 id="actions-title">Fix</h2>
<p id="actions-intro">Each needs a redirect to its closest match, starting with the most linked. Links to a missing page pass no search value, and visitors who follow them land on an error.</p>
<div class="dfs-table" id="fix" tabindex="0"><table>
<thead><tr><th scope="col">Old address</th><th scope="col">Type</th><th scope="col">Result</th><th scope="col" class="dfs-num">Linking sites</th></tr></thead>
<tbody>
<tr><td><code>/coupons/spring-2019</code></td><td>Page</td><td><span class="dfs-badge">404</span></td><td class="dfs-num">46</td></tr>
<tr><td><code>/services/water-heaters/</code></td><td>Page</td><td><span class="dfs-badge">404</span></td><td class="dfs-num">11</td></tr>
<tr><td><code>/old-blog/frozen-pipes</code></td><td>Page</td><td><span class="dfs-badge">No response</span></td><td class="dfs-num">5</td></tr>
</tbody>
</table></div>
<dl class="dfs-terms"><div><dt>Result</dt><dd>404 means page not found. Any other number is an error the server returned.</dd></div></dl>
<aside class="dfs-callout dfs-warn" id="home-redirects"><p><strong>Sent to the homepage.</strong> 1 inner page redirects to the homepage, which Google treats like a missing page. Point it at its closest match.</p></aside>
<h2 id="gated-title">Behind a login</h2>
<p id="gated-note">These hit a sign-in page, so they couldn’t be checked.</p>
<div class="dfs-table" id="gated" tabindex="0"><table>
<thead><tr><th scope="col">Old address</th><th scope="col">Lands on</th><th scope="col" class="dfs-num">Linking sites</th></tr></thead>
<tbody>
<tr><td><code>/account</code></td><td><code>/login?next=%2Faccount</code></td><td class="dfs-num">4</td></tr>
</tbody>
</table></div>
<h2 id="redirecting-title">Redirecting</h2>
<p id="redirecting-note">Old addresses that forward to a live page. Check each lands somewhere a visitor would expect.</p>
<div class="dfs-table" id="redirecting" tabindex="0"><table>
<thead><tr><th scope="col">Old address</th><th scope="col">Lands on</th><th scope="col" class="dfs-num">Linking sites</th></tr></thead>
<tbody>
<tr><td><code>/about-us/</code></td><td><code>/about</code></td><td class="dfs-num">59</td></tr>
<tr><td><code>/blog/2020/03/hello</code></td><td><code>/</code></td><td class="dfs-num">3</td></tr>
<tr><td><code>/drains/</code></td><td><code>/services/drains</code></td><td class="dfs-num">8</td></tr>
</tbody>
</table></div>
<h2 id="unchanged-title">Unchanged</h2>
<div class="dfs-table" id="unchanged" tabindex="0"><table>
<thead><tr><th scope="col">Address</th><th scope="col" class="dfs-num">Linking sites</th></tr></thead>
<tbody>
<tr><td><code>/</code></td><td class="dfs-num">300</td></tr>
</tbody>
</table></div>
<footer class="dfs-footer" id="footer"><p>Data: DataForSEO Backlinks, October 8, 2026.</p></footer>
</article>
"
`;

exports[`toHtml > renders the competitor-gap report 1`] = `
"<article class="dfs-report">
<hgroup id="title"><p class="dfs-kicker">Competitor gap · October 8, 2026</p><h1>acmeplumbing.example against competitors on Google</h1></hgroup>
<p id="answer" class="dfs-lg">rivalplumbing.example and citydrains.example are on Google’s page one for 6 search terms about your work where acmeplumbing.example ranks lower: 2 where it’s further down and 4 where it isn’t in the top 100. Those terms get about 8,790 searches a month.</p>
<dl class="dfs-terms"><div><dt>page one</dt><dd>Positions #1 to #10, the first page of results. Few people click past it.</dd></div></dl>
<dl class="dfs-stats" id="stats">
<div class="dfs-stat"><dt>Behind a competitor</dt><dd class="dfs-value"><a href="#weak-title">2</a></dd><dd class="dfs-note">both rank, the competitor higher</dd></div>
<div class="dfs-stat"><dt>Not ranking</dt><dd class="dfs-value"><a href="#missing-title">4</a></dd><dd class="dfs-note">you’re not in the top 100</dd></div>
<div class="dfs-stat"><dt>Searches a month</dt><dd class="dfs-value"><a href="#themes-title">8,790</a></dd><dd class="dfs-note">across those terms</dd></div>
<div class="dfs-stat"><dt>Competitors</dt><dd class="dfs-value"><a href="#competitors-title">2</a></dd><dd class="dfs-note">compared</dd></div>
</dl>
<details id="method">
<summary>How this was measured</summary>
<ul id="method-list">
<li><strong>What:</strong> Search terms where at least one competitor is on page one (#1 to #10) and acmeplumbing.example is lower or not in the top 100.</li>
<li><strong>Competitors:</strong> rivalplumbing.example and citydrains.example.</li>
<li><strong>Where:</strong> Google in the United States, English. Rankings are national, not what someone searching from one city sees.</li>
<li><strong>When:</strong> Data pulled October 8, 2026.</li>
<li><strong>Source:</strong> DataForSEO Labs, which estimates rankings, searches and visits from its own regular Google crawls.</li>
<li><strong>Sorting:</strong> A term is about your work when it contains a topic word: Plumbing (plumber, plumbing, pipe, repipe, leak, drain, sewer, toilet); Water heaters (water heater); Pumps (sump pump, disposal). Terms with “Acme Plumbing” count as your name. A search for another business or place counts as another name. Everything else is unrelated.</li>
<li><strong>Filter:</strong> For each competitor, up to 100 of its most-searched page-one terms that you also rank for, and up to 100 that you don’t. Terms shared between competitors count once, which leaves 25 terms. 6 are in this report. Left out: 3 terms naming a competitor or another business (like “rival plumbing coupons”), 12 unrelated to your work (like “zip code finder”) and 4 where you already rank ahead.</li>
</ul>
</details>
<h2 id="actions-title">What to do</h2>
<p id="actions-intro">One line per topic, most searched first. Where you rank, improving the page listed is the usual fix. Where you don’t, it’s usually a page that answers the search.</p>
<ol id="actions">
<li><strong>Water heaters:</strong> 2 terms, 5,720 searches a month. The biggest is “tankless water heater”: rivalplumbing.example is #3 and you’re #14 with <code>/services</code>. Your best position is on “water heater install”: rivalplumbing.example is #4 and you’re #8 with <code>/services</code>.</li>
<li><strong>Plumbing:</strong> 3 terms, 2,170 searches a month. The biggest is “hydro jetting drain”: citydrains.example is #2 and you’re not in the top 100.</li>
<li><strong>Pumps:</strong> 1 term, 900 searches a month. The biggest is “sump pump installation”: rivalplumbing.example is #7 and you’re not in the top 100.</li>
</ol>
<h2 id="themes-title">By topic</h2>
<div class="dfs-table" id="themes" tabindex="0"><table>
<thead><tr><th scope="col">Topic</th><th scope="col" class="dfs-num">Searches a month</th><th scope="col" class="dfs-num">Behind</th><th scope="col" class="dfs-num">Not ranking</th><th scope="col">Ahead most often</th></tr></thead>
<tbody>
<tr><td>Water heaters</td><td class="dfs-num"><span class="dfs-bar" aria-hidden="true" style="--w:100"></span>5,720</td><td class="dfs-num">2</td><td class="dfs-num">0</td><td><code>rivalplumbing.example</code></td></tr>
<tr><td>Plumbing</td><td class="dfs-num"><span class="dfs-bar" aria-hidden="true" style="--w:38"></span>2,170</td><td class="dfs-num">0</td><td class="dfs-num">3</td><td><code>citydrains.example</code></td></tr>
<tr><td>Pumps</td><td class="dfs-num"><span class="dfs-bar" aria-hidden="true" style="--w:16"></span>900</td><td class="dfs-num">0</td><td class="dfs-num">1</td><td><code>rivalplumbing.example</code></td></tr>
</tbody>
</table></div>
<dl class="dfs-terms"><div><dt>Searches a month</dt><dd>Average Google searches a month for the term across the United States.</dd></div></dl>
<h2 id="weak-title">Behind a competitor</h2>
<p id="weak-note">Both sites rank and the competitor is higher. These are usually the quickest to improve, since Google already connects acmeplumbing.example to the search.</p>
<div class="dfs-table" id="weak" tabindex="0"><table>
<thead><tr><th scope="col">Search term</th><th scope="col">Topic</th><th scope="col" class="dfs-num">Searches a month</th><th scope="col">Ahead of you</th><th scope="col">You</th><th scope="col">Your page</th></tr></thead>
<tbody>
<tr><td>tankless water heater</td><td>Water heaters</td><td class="dfs-num">5,000</td><td>rivalplumbing.example #3</td><td><span class="dfs-badge">#14</span></td><td><code>/services</code></td></tr>
<tr><td>water heater install</td><td>Water heaters</td><td class="dfs-num">720</td><td>rivalplumbing.example #4</td><td><span class="dfs-badge">#8</span></td><td><code>/services</code></td></tr>
</tbody>
</table></div>
<dl class="dfs-terms"><div><dt>Ahead of you</dt><dd>Where the page shows in Google’s results for that search. #1 is the first result; #1 to #10 is page one.</dd></div></dl>
<h2 id="missing-title">Not ranking</h2>
<p id="missing-note">A competitor is on page one and acmeplumbing.example isn’t in the top 100, usually because no page covers the search.</p>
<div class="dfs-table" id="missing" tabindex="0"><table>
<thead><tr><th scope="col">Search term</th><th scope="col">Topic</th><th scope="col" class="dfs-num">Searches a month</th><th scope="col">Who ranks</th></tr></thead>
<tbody>
<tr><td>hydro jetting drain</td><td>Plumbing</td><td class="dfs-num">1,300</td><td>citydrains.example #2, rivalplumbing.example #9</td></tr>
<tr><td>sump pump installation</td><td>Pumps</td><td class="dfs-num">900</td><td>rivalplumbing.example #7</td></tr>
<tr><td>sewer backflow testing springfield</td><td>Plumbing</td><td class="dfs-num">480</td><td>citydrains.example #1</td></tr>
<tr><td>slab leak repair</td><td>Plumbing</td><td class="dfs-num">390</td><td>rivalplumbing.example #6</td></tr>
</tbody>
</table></div>
<h2 id="competitors-title">By competitor</h2>
<div class="dfs-table" id="competitors" tabindex="0"><table>
<thead><tr><th scope="col">Competitor</th><th scope="col" class="dfs-num">Ahead of you</th><th scope="col" class="dfs-num">Only they rank</th><th scope="col" class="dfs-num">Only they rank, any term</th></tr></thead>
<tbody>
<tr><td><code>rivalplumbing.example</code></td><td class="dfs-num">2</td><td class="dfs-num">3</td><td class="dfs-num">140</td></tr>
<tr><td><code>citydrains.example</code></td><td class="dfs-num">0</td><td class="dfs-num">2</td><td class="dfs-num">38</td></tr>
</tbody>
</table></div>
<dl class="dfs-terms"><div><dt>Only they rank, any term</dt><dd>Every term where they’re on page one and acmeplumbing.example isn’t in the top 100, before terms unrelated to your work are left out.</dd></div></dl>
<footer class="dfs-footer" id="footer"><p>Data: DataForSEO Labs, October 8, 2026.</p></footer>
</article>
"
`;

exports[`toHtml > renders the local-visibility report 1`] = `
"<article class="dfs-report">
<hgroup id="title"><p class="dfs-kicker">Local visibility · October 8, 2026</p><h1>Acme Plumbing on Google Maps</h1></hgroup>
<p id="answer" class="dfs-lg">Acme Plumbing is in the Google Maps top 3 for 1 of 3 searches checked in Springfield, Illinois, United States.</p>
<dl class="dfs-terms"><div><dt>Google Maps top 3</dt><dd>The three listings Google shows with the map at the top of local results. Most taps go to these.</dd></div></dl>
<dl class="dfs-stats" id="stats">
<div class="dfs-stat"><dt>In the top 3</dt><dd class="dfs-value"><a href="#results-title">1</a></dd><dd class="dfs-note">of 3 searches checked</dd></div>
<div class="dfs-stat dfs-warn"><dt>Listed lower</dt><dd class="dfs-value"><a href="#results-title">1</a></dd><dd class="dfs-note">#4 to #20</dd></div>
<div class="dfs-stat dfs-bad"><dt>Not found</dt><dd class="dfs-value"><a href="#results-title">1</a></dd><dd class="dfs-note">outside the top 20</dd></div>
</dl>
<details id="method">
<summary>How this was measured</summary>
<ul id="method-list">
<li><strong>What:</strong> Where Acme Plumbing shows in Google Maps for “plumber”, “water heater repair” and “drain cleaning”, and who holds the top 3.</li>
<li><strong>Where:</strong> Searched from the center of Springfield, Illinois, United States, in English. Maps results change with the searcher’s location, so this is one snapshot.</li>
<li><strong>When:</strong> Searched October 8, 2026.</li>
<li><strong>Matching:</strong> A listing counts as yours when its website is acmeplumbing.example or its name matches “Acme Plumbing”. Your best-placed listing is shown.</li>
<li><strong>Depth:</strong> The top 20 Maps results for each search.</li>
<li><strong>Source:</strong> DataForSEO, which runs the search on Google Maps and returns the listings.</li>
</ul>
</details>
<h2 id="actions-title">What to do</h2>
<p id="actions-intro">Searches where you’re not in the top 3, and who is. Google ranks Maps listings by relevance to the search, distance from the searcher and prominence, which includes reviews.</p>
<ul id="actions">
<li>“water heater repair”: Acme Plumbing is #7. The top 3 are Rival Plumbing (4.8 stars, 312 reviews), Hot Water Heroes (4.9 stars, 88 reviews) and Pipe Pros (4.6 stars, 120 reviews).</li>
