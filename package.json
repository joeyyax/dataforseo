{
  "name": "@joeyyax/dataforseo",
  "version": "0.1.0",
  "description": "DataForSEO client with a pluggable cache, SEO checks and report builders.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/joeyyax/dataforseo.git" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:dist": "pnpm build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.2"
}
